{
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "/app.py"
    },
    {
      "src": "/auth/(.*)",
      "dest": "/app.py"
    },
    {
      "src": "/chat",
      "dest": "/app.py"
    },
    {
      "src": "/chat/stream",
      "dest": "/app.py"
    },
    {
      "src": "/search",
      "dest": "/app.py"
    },
    {
      "src": "/news",
      "dest": "/app.py"
    },
    {
      "src": "/image",
      "dest": "/app.py"
    },
    {
      "src": "/music/(.*)",
      "dest": "/app.py"
    },
    {
      "src": "/music",
      "dest": "/app.py"
    },
    {
      "src": "/memory",
      "dest": "/app.py"
    },
    {
      "src": "/rag/(.*)",
      "dest": "/app.py"
    },
    {
      "src": "/mcp(.*)",
      "dest": "/app.py"
    },
    {
      "src": "/agents",
      "dest": "/app.py"
    },
    {
      "src": "/plans(.*)",
      "dest": "/app.py"
    },
    {
      "src": "/history(.*)",
      "dest": "/app.py"
    },
    {
      "src": "/profile(.*)",
      "dest": "/app.py"
    },
    {
      "src": "/research",
      "dest": "/app.py"
    },
    {
      "src": "/login",
      "dest": "/app.py"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
