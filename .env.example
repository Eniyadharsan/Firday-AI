CEREBRAS_API_KEY=your-cerebras-api-key

# --- Multi-provider AI keys (all optional; add only the providers you want) ---
# Unconfigured providers show as "Not Configured" and are skipped.
OPENAI_API_KEY=          # platform.openai.com — starts with sk-
ANTHROPIC_API_KEY=       # console.anthropic.com — starts with sk-ant-
GOOGLE_AI_API_KEY=       # aistudio.google.com/app/apikey (Gemini)
DEEPSEEK_API_KEY=        # platform.deepseek.com — starts with sk-
XAI_API_KEY=             # console.x.ai (Grok) — starts with xai-
OPENROUTER_API_KEY=      # openrouter.ai/keys — starts with sk-or-
OLLAMA_HOST=http://localhost:11434  # local Ollama server URL (no key needed)

PORT=7860
JWT_SECRET=change-this-to-random-string
RESEND_API_KEY=optional-for-email-otp
YOUTUBE_API_KEY=your-youtube-data-api-v3-key
DEBUG=false

# Dev auto-login (development only — leave DEV_AUTO_LOGIN=false in production)
DEV_AUTO_LOGIN=false
DEV_EMAIL=
DEV_PASSWORD=
