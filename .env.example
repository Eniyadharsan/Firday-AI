# =============================================================================
# Personal AI Assistant - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values before deployment.
# All secrets should be strong, randomly generated strings.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   docker compose up -d
# =============================================================================

# ---- Application ----
NODE_ENV=production
APP_PORT=3000
LOG_LEVEL=info

# ---- Authentication ----
# API key for authenticating requests (generate a strong random string)
# Example: openssl rand -hex 32
API_KEY=your-secret-api-key-here

# ---- Redis ----
# Leave empty for no password (development only), set for production
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_MAX_MEMORY=512mb

# ---- Qdrant Vector Database ----
QDRANT_API_KEY=
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_ENABLE_TLS=false

# ---- vLLM Inference Engine ----
# Path to the fine-tuned model weights inside the container
VLLM_MODEL_PATH=/models/mistral-7b-finetuned
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_DTYPE=float16
VLLM_PORT=8000
# Which NVIDIA GPUs to expose to vLLM (e.g., "all", "0", "0,1")
VLLM_NVIDIA_DEVICES=all

# ---- Faster-Whisper STT ----
STT_PORT=8001
WHISPER_MODEL_SIZE=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
# Which NVIDIA GPUs to expose to STT (e.g., "all", "0")
STT_NVIDIA_DEVICES=all

# ---- Coqui TTS ----
TTS_PORT=8002
TTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
# Which NVIDIA GPUs to expose to TTS (e.g., "all", "0")
TTS_NVIDIA_DEVICES=all
TTS_CUDA_DEVICES=0

# ---- Embedding Service (sentence-transformers) ----
EMBEDDING_PORT=8003
# Model used for generating text embeddings for RAG
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- TLS / Encryption ----
# Place TLS certificates in ./certs/ directory before deployment:
#   ./certs/server.crt  - Server certificate
#   ./certs/server.key  - Server private key
#   ./certs/ca.crt      - Certificate Authority certificate
TLS_CERT_PATH=/certs/server.crt
TLS_KEY_PATH=/certs/server.key
TLS_CA_PATH=/certs/ca.crt

# ---- Resource Monitoring & Alerts ----
RESOURCE_ALERT_THRESHOLD_PERCENT=80
# Notification channel: webhook, email, or sms
ALERT_NOTIFICATION_CHANNEL=webhook
ALERT_WEBHOOK_URL=https://your-webhook-endpoint.example.com/alerts

# ---- Data Fetcher External APIs ----
# Obtain API keys from respective providers
NEWS_API_KEY=your-news-api-key
WEB_SEARCH_API_KEY=your-web-search-api-key
WEATHER_API_KEY=your-weather-api-key
FINANCE_API_KEY=your-finance-api-key

# ---- Fine-Tuning ----
# Minimum examples required to trigger incremental fine-tuning
FINE_TUNING_MIN_EXAMPLES=50
# Evaluation score threshold below which model rollback occurs
MODEL_ROLLBACK_THRESHOLD=0.60

# ---- Session ----
# Seconds of silence before session is marked inactive
SESSION_SILENCE_TIMEOUT_SECONDS=60
# Maximum exchanges retained in session history (rolling window)
SESSION_MAX_EXCHANGES=50

# ---- Confidence & RAG ----
# Confidence score below this threshold triggers a disclaimer
CONFIDENCE_THRESHOLD=0.7
# Number of top documents to retrieve (1-20)
RAG_TOP_K=5
# Minimum similarity score for document relevance (0.0-1.0)
RAG_RELEVANCE_THRESHOLD=0.7

# ---- Access Logging ----
# Minimum days to retain access log entries
ACCESS_LOG_RETENTION_DAYS=90

# ---- Data Retention & Privacy ----
# Set to true to allow conversation data to be used for model training
TRAINING_OPT_IN=false
