{
  "name": "personal-ai-assistant",
  "version": "0.1.0",
  "description": "Personal AI Assistant (JARVIS-Style) - Cloud-hosted conversational AI with voice interaction, RAG, and real-time data retrieval",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/cloud-server.js",
    "dev": "ts-node src/cloud-server.ts",
    "local": "ts-node src/local-runner.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "ai-assistant",
    "llm",
    "rag",
    "voice",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "4.18.2",
    "google-auth-library": "^10.9.0",
    "groq-sdk": "^1.3.0",
    "ioredis": "5.3.2",
    "jsonwebtoken": "^9.0.3",
    "open": "^11.0.0",
    "typescript": "5.4.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "20.11.19",
    "fast-check": "3.15.1",
    "ts-node": "10.9.2",
    "vitest": "1.3.1"
  }
}
